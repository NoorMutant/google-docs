# Environment variables for a DEPLOYED instance.
#
# You do NOT need any of this to run locally. Local development reads
# backend/src/main/resources/application.yml and creates its own H2 database
# file, so `mvn spring-boot:run` works with no configuration at all.
#
# Spring Boot does not read .env files by itself. This file is here for two
# uses:
#   1. `docker run --env-file .env ...` for a production-like local run
#   2. as the list of values to paste into your host's dashboard, for example
#      the Environment tab of a Render web service
#
# Copy it to .env and fill in real values. .env is gitignored so it never gets
# committed.

# Switches the app from the local H2 file to Postgres, and marks the session
# cookie Secure. Requires HTTPS in front of the app, so leave this unset when
# running a container locally over plain HTTP or sign in will fail.
SPRING_PROFILES_ACTIVE=prod

# Your Postgres database. Note the jdbc: prefix, which some hosts leave out of
# the connection string they show you.
# Supabase: use the Session pooler string, not the direct connection, which is
# IPv6 only on the free plan. Keep the jdbc: prefix and the sslmode parameter.
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.your-project-ref
SPRING_DATASOURCE_PASSWORD=your-database-password

# Optional. Render and similar hosts inject PORT themselves and the app reads
# it, so this normally does not need setting.
# PORT=8080
