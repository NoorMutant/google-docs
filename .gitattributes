# Normalise line endings. The repository stores LF, Windows checkouts get CRLF
# for text files, and anything that a Linux container executes stays LF.
* text=auto eol=lf

*.java   text eol=lf
*.ts     text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.xml    text eol=lf
*.md     text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf

# Never touch binaries.
*.png binary
*.jpg binary
*.ico binary
*.docx binary
*.pdf binary
